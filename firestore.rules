rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. Créneaux occupés publics (ANONYMES) ──
    // Contient UNIQUEMENT : date, heure, coiffeur.
    // Aucun nom, prénom ni numéro de téléphone de client.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if slotId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}_.*$')
                    && request.resource.data.keys().hasOnly(['date','time','barber'])
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && request.resource.data.barber is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ── 2. Réservations privées complètes (DONNÉES SALON) ──
    // Contient : clientName, clientPhone, clientNote, service, etc.
    // LECTURE & SUPPRESSION RÉSERVÉES AU SALON CONNECTÉ
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if bookingId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}_.*$')
                    && request.resource.data.keys().hasAll(['date','time','barber','service','clientName','clientPhone'])
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && request.resource.data.clientName is string
                    && request.resource.data.clientPhone is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ── 3. Configuration passerelle SMS ──
    match /bookings/_config_sms_gateway {
      allow read, write: if request.auth != null;
    }

    // ── 4. Fermetures exceptionnelles du salon ──
    match /closures/{closureId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Bloquer tout le reste ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
